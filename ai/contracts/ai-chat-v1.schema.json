{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmcrestaurant.app/schemas/ai-chat-v1.json",
  "title": "AI Chat Request/Response Contract v1",
  "description": "Shared contract between .NET API and Python AI service. Bump version on breaking changes.",
  "oneOf": [
    { "$ref": "#/$defs/ChatRequest" },
    { "$ref": "#/$defs/ChatResponse" }
  ],
  "$defs": {
    "ChatRequest": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "maxLength": 2000 },
        "session_id": { "type": ["string", "null"] },
        "table_code": { "type": ["string", "null"] },
        "table_session_id": { "type": ["string", "null"] },
        "history": { "type": "array" },
        "session_memory": { "type": "string" },
        "rolling_summary": { "type": ["string", "null"] },
        "excluded_menu_item_ids": { "type": "array", "items": { "type": "string" } },
        "facts": { "type": "array" },
        "cart_items": { "type": "array" },
        "orders": { "type": "array" },
        "promotions": { "type": "array" },
        "local_time": { "type": ["string", "null"] },
        "meal_period": { "type": ["string", "null"] },
        "menu_items": { "type": "array" },
        "menu_version": { "type": ["string", "null"] }
      }
    },
    "ChatResponse": {
      "type": "object",
      "required": ["content", "suggested_cart_actions", "guardrail_flags"],
      "properties": {
        "content": { "type": "string" },
        "provider_available": { "type": "boolean" },
        "suggested_cart_actions": { "type": "array" },
        "guardrail_flags": { "type": "array", "items": { "type": "string" } },
        "follow_up": {
          "type": ["object", "null"],
          "properties": {
            "can_show_more": { "type": "boolean" },
            "remaining_count": { "type": "integer" }
          }
        },
        "suggest_staff_handoff": { "type": "boolean" },
        "facts": { "type": "array" },
        "rejected_menu_item_ids": { "type": "array", "items": { "type": "string" } },
        "updated_rolling_summary": { "type": ["string", "null"] }
      }
    }
  }
}
