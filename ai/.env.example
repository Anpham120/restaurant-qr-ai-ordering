# --- App -> 9router gateway (OpenAI-compatible) ---
LLM_PROVIDER=9router
LLM_BASE_URL=http://localhost:20128/v1
# 9Router gateway key (sk-...), NOT provider OAuth key. Copy from Dashboard > API Keys.
LLM_API_KEY=replace-with-your-9router-gateway-key
# Supported: cx/gpt-5.5 or a DeepSeek route such as oc/deepseek-v4-flash-free
LLM_MODEL=cx/gpt-5.5
AI_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
LLM_TIMEOUT_SECONDS=60

# --- RAG (unchanged) ---
AI_REQUEST_BUDGET_SECONDS=22
RAG_KNOWLEDGE_BASE_PATH=knowledge-base
RAG_TOP_K=5
RAG_RETRIEVAL_METHOD=hybrid
AI_EMBEDDING_MODEL=e5_small
