# Biến môi trường của dịch vụ AI.
#
# Tệp này chỉ liệt kê biến mà MÃ THẬT SỰ ĐỌC. Đối chiếu bằng cách tìm tên biến trong `ai/app/`.
#
# Vì sao có luật đó: bản trước liệt kê 6 biến RAG mà không dòng mã nào đọc, và chúng không im
# lặng — chúng ĐƯỢC TIN. Ai đọc `RAG_RETRIEVAL_METHOD=hybrid` sẽ kết luận triển khai đang chạy
# hybrid, trong khi hybrid đã bị loại sau ba phép đo (p = 0,2891 · 0,8238 · 1,0000). Cùng lý do
# `deploy/docker-compose.yml` đã bỏ chúng.

# --- Gọi mô hình sinh (tùy chọn) --------------------------------------------------------------
#
# Thiếu ba biến này thì dịch vụ VẪN CHẠY: mọi nhánh trả lời đều có đường tất định, và mô hình chỉ
# được gọi ở hai chỗ hẹp (`enrich`, đuôi dài của lớp ý định). Xem `ai/app/service.py`.
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=replace-with-your-gateway-key
LLM_MODEL=replace-with-your-model-id
LLM_TIMEOUT_SECONDS=60

# --- Xác thực nội bộ ---------------------------------------------------------------------------
#
# Backend .NET gửi kèm token này ở mọi lượt gọi. Thiếu -> 401.
AI_INTERNAL_TOKEN=replace-with-a-long-random-internal-token

# --- Đệm vector của kho tri thức ---------------------------------------------------------------
#
# KHÔNG có giá trị mặc định trong mã, có chủ ý: mã tự đoán một đường dẫn thì lúc chạy đọc chỗ khác,
# và hậu quả là im lặng mã hóa lại toàn kho mỗi lần khởi động — 492 giây với `bge-m3`.
#
# Ảnh Docker tự đặt biến này và tính sẵn vector lúc BUILD (`python -m rag.precompute`). Chỉ cần đặt
# tay khi chạy ngoài Docker; bỏ trống thì mỗi lần chạy sẽ mã hóa lại.
#
#   AI_EMBEDDING_CACHE=/duong/dan/toi/corpus-vectors.json
AI_EMBEDDING_CACHE=

# --- Bật đường sinh (mặc định TẮT) -------------------------------------------------------------
#
# Chỉ hai nhánh `filter` và `compare` được sinh chữ — xem `generate.BRANCHES_ALLOWED`. Nhánh tri
# thức KHÔNG bao giờ được sinh, nên mô hình không có đường bịa về giờ mở cửa hay chính sách.
AI_ENABLE_GENERATION=0
