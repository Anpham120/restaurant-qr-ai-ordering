DEPLOY_ENV=staging
COMPOSE_PROJECT_NAME=cmc-restaurant-staging
FRONTEND_PORT=8081
BACKEND_PORT=5001
POSTGRES_PORT=5433
POSTGRES_DB=restaurant_qr_staging
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=replace-with-staging-postgres-password
DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=20
FRONTEND_SERVER_NAMES=staging.cmcrestaurant.app order-staging.cmcrestaurant.app admin-staging.cmcrestaurant.app staff-staging.cmcrestaurant.app kitchen-staging.cmcrestaurant.app
API_SERVER_NAME=api-staging.cmcrestaurant.app
PUBLIC_API_BASE_URL=https://api-staging.cmcrestaurant.app/api
PUBLIC_ORDERING_BASE_URL=https://order-staging.cmcrestaurant.app
PUBLIC_MARKETING_BASE_URL=https://staging.cmcrestaurant.app
PUBLIC_ORDER_HUB_URL=https://api-staging.cmcrestaurant.app/hubs/orders
ASPNETCORE_ENVIRONMENT=Staging
JWT_SIGNING_KEY=replace-with-a-long-random-signing-key
CORS_ALLOWED_ORIGINS=https://staging.cmcrestaurant.app;https://order-staging.cmcrestaurant.app;https://admin-staging.cmcrestaurant.app;https://staff-staging.cmcrestaurant.app;https://kitchen-staging.cmcrestaurant.app
PAYMENTS__VIETQR__BANKID=replace-with-bank-bin
PAYMENTS__VIETQR__ACCOUNTNUMBER=replace-with-account-number
PAYMENTS__VIETQR__ACCOUNTNAME=replace-with-account-name
PAYMENTS__VIETQR__TEMPLATE=compact2
RUN_DB_MIGRATIONS_ON_STARTUP=false
BOOTSTRAP_ADMIN_EMAIL=replace-with-admin-email
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_DEMO_USERS=true
DEMO_ADMIN_EMAIL=replace-with-demo-admin-email
DEMO_ADMIN_PASSWORD=replace-with-demo-admin-password
DEMO_COUNTER_EMAIL=replace-with-demo-counter-email
DEMO_COUNTER_PASSWORD=replace-with-demo-counter-password
DEMO_STAFF_EMAIL=replace-with-demo-staff-email
DEMO_STAFF_PASSWORD=replace-with-demo-staff-password
DEMO_KITCHEN_EMAIL=replace-with-demo-kitchen-email
DEMO_KITCHEN_PASSWORD=replace-with-demo-kitchen-password
CHAT_AI_PROVIDER=python-rag
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_PORT=8001
AI_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL=cx/gpt-5.6-luna-review
# Single-model deployment: leave the fallback model empty.  The AI service
# reports fallback_model=null whenever fallback is disabled, so naming a model
# here makes the deployment claim a fallback it never calls and fails the
# readiness contract in deploy/scripts/health-check.sh.
VITE_USE_MOCK_CHAT=false
VITE_USE_MOCK_ORDER=false

# Bảy biến vừa BỎ khỏi tệp này: LLM_PROVIDER, LLM_RATE_LIMIT_FALLBACK_MODEL,
# LLM_RATE_LIMIT_FALLBACK_ENABLED, AI_PIPELINE_PROFILE, RAG_TOP_K, RAG_RETRIEVAL_METHOD,
# AI_LLM_FIRST.
#
# Không mô-đun nào của bản dựng lại đọc chúng. Tệp này là TÀI LIỆU về biến cần thiết, nên một biến
# chết ở đây tốn thời gian của người dựng môi trường mới: họ sẽ đi tìm giá trị cho
# `AI_PIPELINE_PROFILE=replace-with-pipeline-selection-winner` — việc không thể làm, vì thứ nó trỏ
# tới không còn tồn tại.
#
# Bộ truy hồi KHÔNG do biến môi trường chọn: `answer._bo_truy_hoi_toan_kho()` dùng embedding nếu
# `sentence-transformers` import được, tức nó do NỘI DUNG ẢNH quyết định. Xem
# `ai/evaluation/verify_deploy_config.py`.
