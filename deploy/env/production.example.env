DEPLOY_ENV=production
COMPOSE_PROJECT_NAME=cmc-restaurant-production
FRONTEND_PORT=8080
BACKEND_PORT=5000
POSTGRES_PORT=5432
POSTGRES_DB=restaurant_qr
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=replace-with-production-postgres-password
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=100
FRONTEND_SERVER_NAMES=cmcrestaurant.app order.cmcrestaurant.app admin.cmcrestaurant.app staff.cmcrestaurant.app kitchen.cmcrestaurant.app
API_SERVER_NAME=api.cmcrestaurant.app
PUBLIC_API_BASE_URL=https://api.cmcrestaurant.app/api
PUBLIC_ORDERING_BASE_URL=https://order.cmcrestaurant.app
PUBLIC_MARKETING_BASE_URL=https://cmcrestaurant.app
PUBLIC_ORDER_HUB_URL=https://api.cmcrestaurant.app/hubs/orders
ASPNETCORE_ENVIRONMENT=Production
JWT_SIGNING_KEY=replace-with-a-long-random-signing-key
CORS_ALLOWED_ORIGINS=https://cmcrestaurant.app;https://order.cmcrestaurant.app;https://admin.cmcrestaurant.app;https://staff.cmcrestaurant.app;https://kitchen.cmcrestaurant.app
PAYMENTS__VIETQR__BANKID=replace-with-bank-bin
PAYMENTS__VIETQR__ACCOUNTNUMBER=replace-with-account-number
PAYMENTS__VIETQR__ACCOUNTNAME=replace-with-account-name
PAYMENTS__VIETQR__TEMPLATE=compact2
RUN_DB_MIGRATIONS_ON_STARTUP=false
BOOTSTRAP_ADMIN_EMAIL=replace-with-admin-email
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_DEMO_USERS=false
CHAT_AI_PROVIDER=python-rag
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_PORT=8001
AI_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
LLM_PROVIDER=9router
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=replace-with-your-9router-key
LLM_MODEL=oc/deepseek-v4-flash-free
AI_PIPELINE_PROFILE=replace-with-pipeline-selection-winner
RAG_TOP_K=5
RAG_RETRIEVAL_METHOD=hybrid
AI_LLM_FIRST=true
VITE_USE_MOCK_CHAT=false
VITE_USE_MOCK_ORDER=false
