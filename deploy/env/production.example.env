DEPLOY_ENV=production
COMPOSE_PROJECT_NAME=cmc-restaurant-production
FRONTEND_PORT=8080
BACKEND_PORT=5000
POSTGRES_PORT=5432
POSTGRES_DB=restaurant_qr
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=replace-with-production-postgres-password
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=100
FRONTEND_SERVER_NAMES=cmcrestaurant.app admin.cmcrestaurant.app
API_SERVER_NAME=api.cmcrestaurant.app
PUBLIC_API_BASE_URL=https://api.cmcrestaurant.app/api
PUBLIC_ORDER_HUB_URL=https://api.cmcrestaurant.app/hubs/orders
ASPNETCORE_ENVIRONMENT=Production
JWT_SIGNING_KEY=replace-with-a-long-random-signing-key
CORS_ALLOWED_ORIGINS=https://cmcrestaurant.app;https://admin.cmcrestaurant.app
PAYMENTS__VIETQR__BANKID=replace-with-bank-bin
PAYMENTS__VIETQR__ACCOUNTNUMBER=replace-with-account-number
PAYMENTS__VIETQR__ACCOUNTNAME=replace-with-account-name
PAYMENTS__VIETQR__TEMPLATE=compact2
RUN_DB_MIGRATIONS_ON_STARTUP=true
BOOTSTRAP_ADMIN_EMAIL=replace-with-admin-email
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_DEMO_USERS=false
AI_PROVIDER=python-rag
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_PORT=8001
AI_LLM_PROVIDER=9router
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=replace-with-9router-key
AI_MODEL=gh/gemini-3.1-pro-preview
RAG_TOP_K=5
VITE_USE_MOCK_CHAT=false
VITE_USE_MOCK_ORDER=false
