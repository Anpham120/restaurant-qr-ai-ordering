# PostgreSQL
POSTGRES_PASSWORD=<generate-a-strong-local-password>
POSTGRES_DB=restaurant_qr
POSTGRES_USER=restaurant_user

# Database connection (used by app)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_qr
DB_USERNAME=restaurant_user
DB_PASSWORD=<same-strong-local-password>

# Staging
STAGING_DB_PASSWORD=<generate-a-different-staging-password>
STAGING_DB_HOST=staging-postgres

# Authentication and trusted browser origins
JWT_SIGNING_KEY=<generate-at-least-32-random-characters>
CORS_ALLOWED_ORIGINS=http://localhost:5173;http://localhost:5174;http://localhost:5175;http://localhost:5176
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DEMO_USERS=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
DEMO_KITCHEN_EMAIL=
DEMO_KITCHEN_PASSWORD=
DEMO_COUNTER_EMAIL=
DEMO_COUNTER_PASSWORD=

# VietQR MVP configuration (set real values in GitHub/VPS secrets, never hard-code in code)
PAYMENTS__VIETQR__BANKID=970436
PAYMENTS__VIETQR__ACCOUNTNUMBER=1234567890
PAYMENTS__VIETQR__ACCOUNTNAME=CMC Restaurant
PAYMENTS__VIETQR__TEMPLATE=compact2
